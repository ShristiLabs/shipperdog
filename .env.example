# Local development overrides for docker compose.
# Copy to .env (gitignored) and adjust; all values have safe local defaults.

POSTGRES_DB=shipperdog
POSTGRES_USER=shipperdog
# Local-only default password. Never reuse outside local development.
POSTGRES_PASSWORD=shipperdog
# HS256 signing key for auth tokens (min 32 bytes). Local-only default in
# compose; production injects a high-entropy secret from its secret manager.
# AUTH_JWT_SECRET=change-me-to-at-least-32-bytes-of-entropy
POSTGRES_PORT=5432
REDIS_PORT=6379
# Decision-input cache (S7-03, issue #32): tight timeouts so the
# decision path fails over to direct evaluation in milliseconds;
# the cache degrades fail-closed, never to an allow.
# REDIS_TIMEOUT=200ms
# REDIS_CONNECT_TIMEOUT=250ms
# AUTHORIZATION_DECISION_CACHE_ENABLED=true
# AUTHORIZATION_DECISION_CACHE_TTL=PT15M
GCS_EMULATOR_PORT=4443
API_PORT=8080
# Tester portal (issue #35): nginx on http://localhost:5174, a separate
# app from the console's 5173. Invitation accept links the API mints
# prefix this origin (TESTER_PORTAL_BASE_URL in the backend config).
PORTAL_PORT=5174
# Observability stack (issue #7): all bound to the host loopback only.
MANAGEMENT_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# GRAFANA_ADMIN_PASSWORD=admin
# OpenAPI contract surface (issue #8): deterministic spec metadata so the
# generated contract never diffs on host specifics.
# OPENAPI_SERVER_URL=https://api.shipperdog.dev
# OPENAPI_INFO_VERSION=0.1.0
# SPRINGDOC_API_DOCS_ENABLED=true
# Tester downloads (S8-04, issue #38): the signed-URL TTL (bounded at
# startup at or under both the decision-cache TTL and FR-014's 15-minute
# ceiling) and the HMAC key behind the emulator-mode proxy URL. The key
# default is local-only, same policy as AUTH_JWT_SECRET; production
# injects a real secret and mints GCS V4 URLs instead.
# ARTIFACT_DOWNLOAD_URL_TTL=PT15M
# ARTIFACT_DOWNLOAD_PROXY_SIGNING_KEY=change-me-for-real-deployments
# Inbound webhook receivers (S12-03, issue #53): comma-separated GitHub
# webhook HMAC secrets for POST /webhooks/github (rotation is overlap --
# add the new secret, remove the old). Empty (the default) keeps the
# receiver off: every delivery answers the uniform 401. Generate one in
# your repository's webhook settings and mirror it here to enable.
# WEBHOOKS_GITHUB_SECRETS=

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.shipperdog</groupId>
  <artifactId>shipperdog-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>shipperdog-backend</name>
  <description>ShipperDog modular-monolith backend API</description>

  <properties>
    <java.version>25</java.version>
    <archunit.version>1.5.1</archunit.version>
    <palantir-java-format.version>2.101.0</palantir-java-format.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <bouncycastle.version>1.86</bouncycastle.version>
    <!-- springdoc 3.x is the Spring Boot 4 line (issue #8); the starter
         is generated at build time and published as a CI artifact. -->
    <springdoc.version>3.1.1</springdoc.version>
    <bucket4j.version>8.10.1</bucket4j.version>
    <!-- Google Cloud Storage Java client (E5/S5-01): the one object-
         storage dependency, used against both the compose GCS emulator
         (fsouza/fake-gcs-server) and production GCS. OSS, Apache-2.0,
         version-pinned here. -->
    <google-cloud-storage.version>2.72.0</google-cloud-storage.version>
    <!-- dd-plist (issue #21, S5-02): the proven OSS Apple property-list
         library (MIT) — reads and writes both binary and XML plists, so
         the IPA parser never hand-rolls bplist decoding and the test
         fixtures generate real binary plists programmatically. -->
    <dd-plist.version>1.29</dd-plist.version>
    <!-- Vulnerability remediation (issue #39, S8-05): the CI OSV scan
         gate found known CVEs in the Spring Boot 4.1.1-managed
         versions — Tomcat embed 11.0.24 (three CRITICALs) and Jackson
         3.1.5 / 2.21.5 (several HIGHs) — all fixed in the patch
         versions pinned here. Bumps stay inside the managed line;
         Spring Boot's own dependency management does the rest. -->
    <tomcat.version>11.0.26</tomcat.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
    <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Vulnerability remediation (issue #39, S8-05): testcontainers
           pulls commons-compress 1.24.0 (two MODERATE CVEs); the scan
           gate runs clean only on the fixed line. Test-scope only. -->
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-compress</artifactId>
        <version>1.28.0</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
    </dependency>
    <!-- Argon2id password hashing (issue #3): spring-security-crypto ships the
         Argon2PasswordEncoder but delegates the algorithm to Bouncy Castle, so
         the provider must be on the runtime classpath. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- Redis (issue #32, S7-03): the decision-input cache's store — the
         grant set per tester x tenant, the membership effectiveness
         flag, and the tenant-application visibility flag the layered
         engine's decision path resolves. The compose stack runs redis:8
         (infrastructure/docker-compose.yml) and the API degrades to
         direct evaluation when Redis is unavailable (fail-closed
         correctness, slower — the story's AC3), which is also why the
         Redis health indicator stays off: cache availability is not an
         API health dependency by design. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- In-app rate limiting (issue #39, S8-05): local token buckets for
         the login door and the download tier. Core only — buckets are
         per-instance by design (the gateway fronts production and owns
         cross-instance aggregation; see docs/deployment.md). -->
    <dependency>
      <groupId>com.bucket4j</groupId>
      <artifactId>bucket4j-core</artifactId>
      <version>${bucket4j.version}</version>
    </dependency>
    <!-- OpenAPI 3 contract generation (issue #8): springdoc 3.x is the
         Spring Boot 4 line; the api (non-UI) starter serves /v3/api-docs
         which CI snapshots at build time as the published contract
         artifact. Swagger UI is deliberately absent (minimal surface;
         Dwara fronts production traffic). -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
      <version>${springdoc.version}</version>
    </dependency>
    <!-- Observability baseline (issue #7): tracing through Micrometer
         observations bridged onto the OpenTelemetry SDK, so every HTTP
         request produces a span without a javaagent. Boot 4 split the
         micrometer integrations into dedicated modules; the auto-
         configuration is ConditionalOnClass(io.micrometer.tracing.otel
         .bridge.OtelTracer) and does NOT pull the bridge itself, so the
         bridge jar must be declared here for tracing to activate (a
         missing bridge fails silently to the noop tracer). Versions come
         from the Boot BOM (micrometer-tracing-bom,
         opentelemetry-bom). -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
    </dependency>
    <!-- Prometheus scrape endpoint (/actuator/prometheus) exposing JVM and
         HTTP server metrics from the actuator's meter registry. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- OTLP span export (PRD section 28: vendor-neutral export from day
         one). Disabled by default; enabled by endpoint configuration so
         local runs without a collector stay quiet. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Object storage client (issue #20, S5-01, FR-007/PRD 24): one
         implementation serves both the emulator (host-configured, no
         credentials) and production GCS (application default
         credentials) behind the artifact module's ArtifactStore port.
         ADR-0003 records the choice. -->
    <dependency>
      <groupId>com.google.cloud</groupId>
      <artifactId>google-cloud-storage</artifactId>
      <version>${google-cloud-storage.version}</version>
    </dependency>
    <!-- Apple property-list parsing (issue #21, S5-02, FR-005): IPA
         metadata lives in binary Info.plist files and XML provisioning
         profiles; dd-plist is the pinned, proven parser for both
         formats (the issue's technical notes name it; hand-rolled
         bplist decoding is explicitly avoided). -->
    <dependency>
      <groupId>com.googlecode.plist</groupId>
      <artifactId>dd-plist</artifactId>
      <version>${dd-plist.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>

    <!-- Test dependencies -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- In-memory span capture for observability tests (issue #7):
         records finished spans instead of exporting them. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-micrometer-tracing-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.3</version>
        <configuration>
          <java>
            <palantirJavaFormat>
              <version>${palantir-java-format.version}</version>
            </palantirJavaFormat>
            <importOrder/>
            <removeUnusedImports/>
            <formatAnnotations/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

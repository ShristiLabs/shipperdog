{
 "title": "ShipperDog API",
 "uid": "shipperdog-api",
 "tags": [
  "shipperdog",
  "issue-7"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Request rate (req/s by route)",
   "description": "Issue #7 baseline: request rate from http.server.requests. Route is the URI template, so cardinality stays bounded.",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"api\"}[$__rate_interval]))",
     "legendFormat": "{{uri}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "title": "Error rate (5xx responses/s)",
   "description": "SERVER_ERROR outcome of http.server.requests, total across routes.",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 6,
    "x": 12,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "expr": "sum(rate(http_server_requests_seconds_count{job=\"api\", outcome=\"SERVER_ERROR\"}[$__rate_interval]))",
     "legendFormat": "5xx",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "title": "p95 latency by route",
   "description": "histogram_quantile over http.server.requests buckets (percentiles-histogram is enabled by default).",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (uri, le) (rate(http_server_requests_seconds_bucket{job=\"api\"}[$__rate_interval])))",
     "legendFormat": "{{uri}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "title": "Authorization decisions (rate by outcome)",
   "description": "shipperdog_authorization_decision_duration by outcome \u2014 the PRD section 42 under-100ms SLO signal.",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 6,
    "x": 0,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "expr": "sum by (outcome) (rate(shipperdog_authorization_decision_duration_seconds_count{job=\"api\"}[$__rate_interval]))",
     "legendFormat": "{{outcome}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "title": "Authorization decision p95",
   "description": "SLO target: under 100ms (PRD section 42).",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 6,
    "x": 6,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(shipperdog_authorization_decision_duration_seconds_bucket{job=\"api\"}[$__rate_interval])))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "title": "JVM memory used (heap)",
   "description": "Sanity panel proving JVM metrics flow through the baseline.",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "expr": "sum by (id) (jvm_memory_used_bytes{job=\"api\", area=\"heap\"})",
     "legendFormat": "{{id}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "title": "Availability (uptime, 1h window)",
   "description": "1 - 5xx fraction over the trailing hour against ALL requests: the PRD 42 availability SLO is 99.9% for the API and the tester portal (S8-05, issue #39). Thresholds: green >= 99.9, red below.",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 6,
    "x": 0,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "decimals": 4,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.99
       },
       {
        "color": "green",
        "value": 0.999
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto"
   },
   "targets": [
    {
     "expr": "1 - (sum(rate(http_server_requests_seconds_count{job=\"api\", outcome=\"SERVER_ERROR\"}[1h])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"api\"}[1h])), 0.000001))",
     "legendFormat": "availability",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "title": "Error rate % (5xx share, SLO view)",
   "description": "The 5xx share of all requests (S8-05): the error-rate half of the availability story; the SLO budget is 0.1%.",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 6,
    "x": 6,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "expr": "sum(rate(http_server_requests_seconds_count{job=\"api\", outcome=\"SERVER_ERROR\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"api\"}[$__rate_interval])), 0.000001)",
     "legendFormat": "5xx share",
     "refId": "A"
    }
   ]
  },
  {
   "id": 9,
   "title": "Rate-limit rejections (per rule)",
   "description": "shipperdog_ratelimit_rejected (S8-05, issue #39): sustained login-rule rejections are the brute-force early warning beside the identity lockout.",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 6,
    "x": 12,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "expr": "sum by (rule) (rate(shipperdog_ratelimit_rejected_total[$__rate_interval]))",
     "legendFormat": "{{rule}}",
     "refId": "A"
    }
   ]
  }
 ],
 "description": "ShipperDog API operational dashboard (S1-07); availability + error-rate panels added by S8-05 (issue #39) against the PRD 42 SLOs."
}
